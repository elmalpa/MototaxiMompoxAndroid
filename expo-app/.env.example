# Desarrollo: IP del computador visible desde el telefono.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000

# Produccion debe configurarse en EAS con una URL HTTPS:
# eas secret:create --scope project --name EXPO_PUBLIC_API_URL --value https://api.tudominio.com
EAS_PROJECT_ID=

# Build-time Google Maps key restricted to Android package + signing SHA-1.
GOOGLE_MAPS_API_KEY=
# EAS file variable containing the path to google-services.json.
GOOGLE_SERVICES_JSON=
