PORT=4000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=generate_a_random_secret_of_at_least_32_characters
CORS_ORIGINS=http://localhost:8081

DB_USER=sa
DB_PASSWORD=change_me
DB_SERVER=127.0.0.1
DB_DATABASE=MototaxiMompox
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_CERT=true

# HTTPS gateway that accepts {to, message}; never expose these values in the app.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=

# Tu Android + SIM Tigo mediante SMS Gateway for Android (ver SMS_ANDROID_SETUP.md).
# Configurar SMS_PROVIDER=smsgate solo despues de obtener las credenciales del movil.
SMS_PROVIDER=webhook
SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_DEVICE_ID=
SMSGATE_SIM_NUMBER=1
